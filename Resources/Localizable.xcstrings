        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ekran bir oyun yarı çözünürlükte kaydedilir; kare hızı ve codec değişmez."
          }
        }
      }
    },
    "A private export file could not be created safely.": {
      "extractionState": "manual",
      "comment": "Screenshot editor",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A private export file could not be created safely."
