      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture modifier: hold the button and drag with the left button for a screenshot, with the right button for text; a tap opens the region picker. Hold → region: hold and drag, release to capture; tap once, then hold, to capture text."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakalama tuşu: tuşu basılı tut, sol tuşla sürüklersen ekran görüntüsü, sağ tuşla sürüklersen metin çeker; tek dokunuş bölge seçimini açar. Basılı tut → bölge: tutup sürükle, bırakınca çeker; önce bir kez dokunup sonra tutarsan metin çeker."
