        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt sürüyor. Seviyeler canlı değişir."
          }
        }
      }
    },
    "A short confirmation when an image or text is copied.": {
      "comment": "Setting note",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short confirmation when an image or text is copied."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir görüntü ya da metin kopyalanınca kısa bir onay gösterir."
          }
        }
      }
    },
    "A thin glow follows the window you record and never appears in the file. The red frame you see after picking a window always shows.": {
      "comment": "Setting footnote",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A thin glow follows the window you record and never appears in the file. The red frame you see after picking a window always shows."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettiğin pencerenin çevresinde ince bir parıltı dolaşır ve dosyaya girmez. Pencereyi seçtikten sonra çıkan kırmızı çerçeve her zaman görünür."
          }
        }
      }
    },
