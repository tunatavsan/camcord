    "A distinct sound for each action: region, window, text, recording, paste.": {
      "comment": "Setting note",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A distinct sound for each action: region, window, text, recording, paste."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her eylem için ayrı bir ses: bölge, pencere, metin, kayıt, yapıştırma."
          }
        }
      }
    },
    "A file with that name already exists.": {
      "extractionState": "manual",
      "comment": "Library interface",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file with that name already exists."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adda bir dosya zaten var."
          }
        }
      }
    },
    "A full-screen game records at half resolution; frame rate and codec stay the same.": {
      "comment": "Setting note",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen game records at half resolution; frame rate and codec stay the same."
